// Ogigrid Smart Solutions — customer-facing website data model.
//
// Scope note: this schema intentionally contains NO authentication/user
// tables. This corporate site has no end-user login system — only an
// admin-key-protected export endpoint (see /api/export/leads.js) for
// OSS staff to pull lead data. Keeping auth entirely out of this schema
// is what makes the JSON export in Section 8 of the design doc safe by
// construction: there is nothing sensitive to accidentally leak.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer via Neon) — used at runtime by serverless functions.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only for migrations.
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model DemoRequest {
  id              String     @id @default(uuid())
  institutionName String
  institutionSize String?
  contactName     String
  email           String
  phone           String?
  role            String?
  message         String?
  status          LeadStatus @default(NEW)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([email])
  @@map("demo_requests")
}

model ContactMessage {
  id        String     @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([email])
  @@map("contact_messages")
}
