{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|@vite|@react-refresh|src/)(?!.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
